# This project does not need any package lifecycle scripts.
#
# esbuild ships its platform binary in the optional dependency
# @esbuild/<platform>-<arch> (the postinstall script only re-links it), and the
# Tailwind/PostCSS CLIs are plain Node entry points. Skipping scripts therefore
# costs nothing here, and it lets `npm install` succeed in restricted shells
# where spawning a package script is denied (DSH sandbox and similar).
ignore-scripts=true

# Keep the install fully deterministic for a lockfile-driven frontend.
save-exact=true
