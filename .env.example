# IncidentLens — Environment Variables Template
# Copy this file to .env and fill in your keys.
# Both providers offer free tiers — no credit card required.

# ── Cloud Model Keys ──────────────────────────────────────
GROQ_API_KEY=""              # https://console.groq.com/keys
OPENROUTER_API_KEY=""        # https://openrouter.ai/keys

# ── LangSmith (debug tracing, optional) ──────────────────
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY=""         # https://smith.langchain.com
LANGCHAIN_PROJECT="IncidentLens"

# ── Langfuse (production monitoring, optional) ────────────
LANGFUSE_PUBLIC_KEY=""       # https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
